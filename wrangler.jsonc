{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sydneyn-dev",
  "compatibility_date": "2026-05-29",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist"
  }
}
