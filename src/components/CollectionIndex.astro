---
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";
import titleCase from "../titleCase";
import Breadcrumbs from "./Breadcrumbs.astro";

interface Props {
  title: string;
  description: string;
  slug: string;
  items: any[];
}

const { title, description, items, slug } = Astro.props;
---

<Base pageTitle={title} description={description}>
  <div class="flex items-center gap-2">
    <Breadcrumbs
      items={[
        { label: "Collections", href: "/collections" },
        { label: titleCase(slug) },
      ]}
    />
    <a
      href={`/in/${slug}.xml`}
      class="flex h-8 w-8 items-center justify-center rounded-full transition-colors hover:bg-crust text-peach hover:text-maroon ignored-link"
      aria-label="RSS Feed"
    >
      <Icon name="mdi:rss" class="h-5 w-5" />
    </a>
  </div>
  <h1 class="text-3xl font-bold mb-2 flex flex-row flex-wrap gap-2"></h1>
  <p class="mb-5">
    {description}
  </p>

  {items.length === 0 && <p>Nothing here yet.</p>}
  <slot />
</Base>
