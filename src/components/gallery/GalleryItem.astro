---
import { transformImage } from "../../image";

interface Props {
  id: number;
  name: string;
  width?: number;
  height?: number;
}

const { id, name, width, height } = Astro.props;

const DEFAULT_WIDTH = 1920;
const DEFAULT_HEIGHT = 1080;
---

<div class="mb-4">
  <a
    href={`/gallery/${id}`}
    class="block p-1 rounded-xl transition-all duration-300 ease-out border bg-base border-surface0 hover:border-overlay0 hover:bg-surface0/30 hover:shadow-lg hover:-translate-y-1 ignored-link"
  >
    <img
      class="rounded-lg w-full h-auto"
      src={transformImage(name, {
        width: (width || DEFAULT_WIDTH) * 0.1,
        height: (height || DEFAULT_HEIGHT) * 0.1,
        quality: 100,
      })}
      alt={name}
      width={(width || DEFAULT_WIDTH) * 0.1}
      height={(height || DEFAULT_HEIGHT) * 0.1}
    />
  </a>
</div>
