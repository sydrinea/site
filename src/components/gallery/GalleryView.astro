---
import GalleryItem from "./GalleryItem.astro";

interface GalleryImage {
  name: string;
  date: string;
  width?: number;
  height?: number;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;

// Sort by date (newest first)
const sorted = images.sort((a, b) =>
  new Date(a.date) < new Date(b.date) ? 1 : -1,
);

// Add sortIndex to each image
const withIndex = sorted.map((img, i) => ({ ...img, sortIndex: i }));
---

<div
  class="columns-[120px] sm:columns-[140px] md:columns-[160px] gap-2"
  id="gallery"
>
  {
    withIndex.map((img) => (
      <GalleryItem
        id={img.sortIndex}
        name={img.name}
        width={img.width}
        height={img.height}
      />
    ))
  }
</div>
