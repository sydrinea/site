---
import GalleryItem from "./GalleryItem.astro";

interface GalleryImage {
  name: string;
  date: string;
  width?: number;
  height?: number;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-4">
  {
    images
      .sort((a, b) => (new Date(a.date) < new Date(b.date) ? 1 : -1))
      .map((img, key) => (
        <GalleryItem
          id={key}
          name={img.name}
          width={img.width}
          height={img.height}
        />
      ))
  }
</div>
