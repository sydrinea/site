---
import { Icon } from "astro-icon/components";
---

<header class="sticky top-4 z-50 mb-10 flex justify-center px-5">
  <nav
    class="relative flex items-center gap-2 rounded-full border border-white/10 bg-mantle/50 p-2 backdrop-blur-md"
  >
    <div
      id="nav-pill"
      class="absolute left-0 top-0 -z-10 h-0 w-0 rounded-full bg-surface1/30 opacity-0 transition-all duration-300 ease-out"
    >
    </div>
    <a
      class="nav-link ignored-link relative z-10 flex items-center gap-2 rounded-full px-4 py-2 text-subtext1 no-underline transition-colors hover:text-text"
      href="/"
      aria-label="Home"
    >
      <Icon name="mdi:home" class="h-5 w-5 sm:hidden" />
      <span class="hidden sm:block">home</span>
    </a>
    <a
      class="nav-link ignored-link relative z-10 flex items-center gap-2 rounded-full px-4 py-2 text-subtext1 no-underline transition-colors hover:text-text"
      href="/in/blog"
      aria-label="Blog"
    >
      <Icon name="mdi:pencil-box-multiple-outline" class="h-5 w-5 sm:hidden" />
      <span class="hidden sm:block">blog</span>
    </a>
    <a
      class="nav-link ignored-link relative z-10 flex items-center gap-2 rounded-full px-4 py-2 text-subtext1 no-underline transition-colors hover:text-text"
      href="/projects"
      aria-label="Projects"
    >
      <Icon name="carbon:tool-box" class="h-5 w-5 sm:hidden" />
      <span class="hidden sm:block">projects</span>
    </a>
    <a
      class="nav-link ignored-link relative z-10 flex items-center gap-2 rounded-full px-4 py-2 text-subtext1 no-underline transition-colors hover:text-text"
      href="/gallery"
      aria-label="Gallery"
    >
      <Icon name="carbon:image-copy" class="h-5 w-5 sm:hidden" />
      <span class="hidden sm:block">gallery</span>
    </a>
  </nav>
</header>

<style>
  @media (hover: none) {
    #nav-pill {
      display: none;
    }
  }
</style>

<script is:inline data-astro-rerun>
  {
    const navLinks = document.querySelectorAll(".nav-link");
    const navPill = document.getElementById("nav-pill");
    const nav = document.querySelector("nav");

    // Only enable pill animations on devices that support hover
    if (navPill && nav && window.matchMedia("(hover: hover)").matches) {
      // Reset pill styles on init: ensure it's hidden initially
      navPill.style.opacity = "0";

      navLinks.forEach((link) => {
        link.addEventListener("mouseenter", (e) => {
          const target = e.currentTarget;
          const rect = target.getBoundingClientRect();
          // Ensure parent matches the relative container
          const parent = target.closest("nav");
          if (!parent) return;

          const parentRect = parent.getBoundingClientRect();

          // Calculate position relative to container
          const left = rect.left - parentRect.left;
          const top = rect.top - parentRect.top;

          navPill.style.width = `${rect.width}px`;
          navPill.style.height = `${rect.height}px`;
          navPill.style.transform = `translate(${left}px, ${top}px)`;
          navPill.style.opacity = "1";
        });
      });

      nav.addEventListener("mouseleave", () => {
        navPill.style.opacity = "0";
      });
    }
  }
</script>
