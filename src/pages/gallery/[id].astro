---
import { allImages, transformImage } from "../../image";
import { Icon } from "astro-icon/components";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";

const DEFAULT_WIDTH = 1920;
const DEFAULT_HEIGHT = 1080;

export const getStaticPaths = async () => {
  const count = (await allImages()).length;
  return Array.from({ length: count }).map((_, index) => ({
    params: { id: index },
  }));
};

const images = (await allImages()).sort((a, b) =>
  new Date(a.date) < new Date(b.date) ? 1 : -1,
);

const index = Number(Astro.params.id);
const { name, width, height, date, lens } = images[index];
const quarterPercent = transformImage(name, {
  width: (width || DEFAULT_WIDTH) * 0.25,
  height: (height || DEFAULT_HEIGHT) * 0.25,
  quality: 100,
});
const previous = Math.max(0, index - 1);
const next = Math.min(images.length - 1, index + 1);
---

<Base
  pageTitle={name}
  description={`${width}x${height} digital image captured on ${date}`}
  image={quarterPercent}
>
  <div class="relative mb-3">
    <div class="space-y-2">
      <Breadcrumbs
        items={[{ label: "Gallery", href: "/gallery" }, { label: name }]}
      />
      <p class="font-light text-subtext0">
        {date}
        —
        {lens}
      </p>
    </div>
  </div>

  <div class="flex flex-col gap-6">
    <img
      class="mx-auto max-h-[80vh] object-contain"
      src={quarterPercent}
      alt={name}
      width={(width || DEFAULT_WIDTH) * 0.25}
      height={(height || DEFAULT_HEIGHT) * 0.25}
    />

    <div
      class="flex items-center justify-between gap-4 py-4 border-t border-surface0"
    >
      {
        index > 0 ? (
          <a
            id="previous"
            aria-label="Previous image"
            class="ignored-link text-text p-2 transition-colors rounded-lg hover:bg-surface0"
            href={`/gallery/${previous}`}
          >
            <div class="flex items-center gap-2">
              <Icon name="mdi:keyboard-arrow-left" class="text-2xl" />
            </div>
          </a>
        ) : (
          <div />
        )
      }

      {
        index < images.length - 1 ? (
          <a
            id="next"
            aria-label="Next image"
            class="ignored-link text-text p-2 transition-colors rounded-lg hover:bg-surface0"
            href={`/gallery/${next}`}
          >
            <div class="flex items-center gap-2">
              <Icon name="mdi:keyboard-arrow-right" class="text-2xl" />
            </div>
          </a>
        ) : (
          <div />
        )
      }
    </div>
  </div>

  <script>
    document.addEventListener("keydown", (ev) => {
      // Don't intercept if modifier keys are pressed
      if (ev.metaKey || ev.ctrlKey || ev.altKey) return;

      if (ev.code === "ArrowLeft" || ev.code === "KeyH" || ev.code === "KeyA") {
        ev.preventDefault();
        document.getElementById("previous")?.click();
      } else if (
        ev.code === "ArrowRight" ||
        ev.code === "KeyL" ||
        ev.code === "KeyD"
      ) {
        ev.preventDefault();
        document.getElementById("next")?.click();
      }
    });
  </script>
</Base>
