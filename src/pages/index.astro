---
import { getCollection } from "astro:content";
import { Content as ShortBio } from "../content/misc/short-bio.mdx";
import { socials } from "../../data/config.json";
import Social from "../components/Social.astro";
import NodeCard from "../components/NodeCard.astro";
import Base from "../layouts/Base.astro";

const nodes = await getCollection("nodes");
const blogPosts = nodes
  .filter((node) => node.data.collection === "blog")
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
  );
const mostRecentPost = blogPosts[0];
---

<Base
  pageTitle="Sydney Newmark"
  description="My personal corner of the internet, where I write about my projects and experiences in tech and elsewhere."
>
  <div class="flex flex-col gap-6">
    <section>
      <div class="flex flex-col gap-4">
        <h2 class="text-2xl font-bold font-serif text-text">Sydney Newmark</h2>
        <div class="prose max-w-none text-text">
          <ShortBio />
        </div>
        <div class="flex flex-row gap-x-3 mt-2">
          <Social
            label="Sydney Newmark's GitHub"
            icon="carbon:logo-github"
            link={socials.github}
          />
          <Social
            label="Sydney Newmark's Bluesky"
            icon="fa6-brands:bluesky"
            link={socials.bluesky}
          />
          <Social
            label="Sydney Newmark's Mastodon"
            icon="fa6-brands:mastodon"
            link={socials.mastodon}
          />
        </div>
      </div>
    </section>
    {
      mostRecentPost && (
        <section>
          <h3 class="text-xl font-bold font-serif text-text mb-4">
            Latest Post
          </h3>
          <NodeCard
            title={mostRecentPost.data.title}
            description={mostRecentPost.data.description}
            date={new Date(mostRecentPost.data.pubDate)}
            url={`/node/${mostRecentPost.slug}`}
          />
        </section>
      )
    }
  </div>
</Base>
