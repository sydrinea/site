---
import { Icon } from "astro-icon/components";
import TagArray from "../components/TagArray.astro";
import Base from "./Base.astro";
import titleCase from "../titleCase";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const { frontmatter } = Astro.props;
---

<Base pageTitle={frontmatter.title} description={frontmatter.description}>
  <Breadcrumbs
    items={[
      { label: "Collections", href: "/collections" },
      { label: "Notes", href: "/in/notes" },
      { label: frontmatter.title },
    ]}
  />
  {frontmatter.description && <p class="my-2">{frontmatter.description}</p>}
  <article class="prose sm:prose-lg leading-6 mt-4">
    <slot />
  </article>
  <TagArray tags={frontmatter.tags} />
</Base>
